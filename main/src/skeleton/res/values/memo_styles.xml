<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MemoTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/memo_bg</item>
        <item name="android:statusBarColor">@color/memo_bg</item>
        <item name="android:navigationBarColor">@color/memo_bg</item>
        <item name="android:textColor">@color/memo_text</item>
        <item name="android:colorAccent">@color/memo_green</item>
    </style>
    <style name="MemoChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/memo_chip_bg</item>
        <item name="android:textColor">@color/memo_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
