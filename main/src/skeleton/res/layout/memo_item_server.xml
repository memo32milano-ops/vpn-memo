<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/memo_card_bg"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/memo_item_flag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/memo_item_country"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/memo_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/memo_item_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/memo_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/memo_item_ping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/memo_green"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
